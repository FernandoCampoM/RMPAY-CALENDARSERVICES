#!/bin/sh
# Antes de cada push: corre los tests y recompila el instalador (installer/build.ps1).
# Si algo falla, el push se cancela. Para saltarlo en un caso puntual: git push --no-verify
# Se activa una vez por copia del repositorio con: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"

# Aviso (no cancela el push): si cambian el instalador, el túnel o la conexión con Shopify sin
# tocar las guías (src/main/resources/static/admin/guias), recuerda actualizarlas.
# Git pasa por stdin una línea por rama: <ref local> <sha local> <ref remota> <sha remota>
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha~1")..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    changed="$(git diff --name-only "$range" 2>/dev/null)"
    sensitive="$(printf '%s\n' "$changed" | grep -E '^installer/|TunnelService|AdminTunnelController|/Shopify/ShopifyGraphQLClient|/webhook/|application\.properties$' )"
    guides="$(printf '%s\n' "$changed" | grep -E '^src/main/resources/static/admin/guias/')"
    if [ -n "$sensitive" ] && [ -z "$guides" ]; then
        echo "pre-push: AVISO: cambiaron archivos de instalación, túnel o Shopify sin actualizar las guías:"
        printf '%s\n' "$sensitive" | sed 's/^/pre-push:   /'
        echo "pre-push: revise src/main/resources/static/admin/guias/ (el push continúa)."
    fi
done

echo "pre-push: corriendo tests y recompilando el instalador..."
if ! powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/installer/build.ps1"; then
    echo "pre-push: falló la verificación o la compilación del instalador; el push se canceló."
    echo "pre-push: revise el error de arriba (reportes de tests en target/surefire-reports)."
    exit 1
fi
